### Jarvis — example environment variables

# LLMs / Voice
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-proj-your-key-here

# Supabase (public values safe for client-only usage)
# If running Supabase locally with the Supabase CLI, set the URL to the API port (default: http://localhost:54321)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-public-key-placeholder

# Jarvis configuration
NEXT_PUBLIC_WAKE_WORD=jarvis
NEXT_PUBLIC_JARVIS_VOICE=alloy
NEXT_PUBLIC_REALTIME_MODEL=gpt-4o-realtime-preview

# Optional
GEMINI_API_KEY=your-gemini-key-here
GROQ_API_KEY=
