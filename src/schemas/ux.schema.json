{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["screens", "user_flow"],
  "properties": {
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "elements"],
        "properties": {
          "name": { "type": "string" },
          "elements": { "type": "array" },
          "layout_notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "user_flow": { "type": "array", "items": { "type": "string" } },
    "accessibility_notes": { "type": "string" }
  },
  "additionalProperties": false
}
