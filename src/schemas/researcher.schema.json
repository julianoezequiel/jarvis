{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["summary", "key_findings"],
  "properties": {
    "summary": { "type": "string" },
    "key_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["point", "source", "url"],
        "properties": {
          "point": { "type": "string" },
          "source": { "type": "string" },
          "url": { "type": "string", "format": "uri" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
