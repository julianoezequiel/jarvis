{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["files"],
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "language", "content"],
        "properties": {
          "path": { "type": "string" },
          "language": { "type": "string" },
          "content": { "type": "string" }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "explanation": { "type": "string" }
  },
  "additionalProperties": false
}
