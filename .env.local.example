# Copy this file to `.env.local` and fill in your real keys (DO NOT COMMIT `.env.local`)

# LLMs / Voice
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Gemini — key gratuita usada primeiro; quando cota esgota (HTTP 429) cai para GEMINI_API_KEY (paga)
# A UI exibe aviso vermelho quando a chave paga está ativa.
GEMINI_API_KEY_FREE=   # aistudio.google.com (gratuita)
GEMINI_API_KEY=        # Google Cloud (paga, fallback)

# Jarvis configuration
NEXT_PUBLIC_WAKE_WORD=jarvis
NEXT_PUBLIC_JARVIS_VOICE=alloy
NEXT_PUBLIC_REALTIME_MODEL=gpt-4o-realtime-preview

# Optional
GEMINI_API_KEY=
GROQ_API_KEY=
